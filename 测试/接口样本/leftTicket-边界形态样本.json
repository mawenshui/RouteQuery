      "31": "zy_num",
      "32": "swz_num",
      "33": "srrb_num"
    },
    "发现2_canWebBuy取值": {
      "内容": "列 11 不止 Y/N。实测分布：{\"Y\":70,\"N\":2,\"IS_TIME_NOT_BUY\":50}（样本 122 条）",
      "修正": "不得对列 11 施加 ^[YN]$ 校验。IS_TIME_NOT_BUY 是合法值，含义为\"该日期尚未开售\"。"
    },
    "发现3_星号语义": {
      "内容": "列 20-33 出现 \"*\"。47 条含星号车次的列 11 全部为 IS_TIME_NOT_BUY；72 条 Y/N 车次中 0 条含星号。",
      "结论": "星号=尚未开售、官方未给出席别数据，不是余票值。未开售另有第二种表现（整行席别全空，如 G1025）。故\"是否开售\"必须以列 11 为唯一判据，不得由席别列反推。"
    }
  },
