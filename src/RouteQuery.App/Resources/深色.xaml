<!-- ═══════════════════════════════════════════════════════════════
     深色色板（FR-35 + FR-38 渐变皮肤）。与浅色**键名必须完全一致**：
     切换主题是整本换掉，缺一个键不会报错，只会让那段底色落回系统默认——
     深色底上一段浅灰默认底，正是 FR-35 验收①要拦的残留。

     深色下颜色一律提亮而不是照搬浅色值：#B3261E 在 #1B1B1E 上只有约 2.6:1，
     错误态必须醒目，所以换成 #FF8A80。渐变同理——两端都提亮，但**幅度压住**，
     否则深色里的渐变会变成"两块脏玻璃"。

     笔刷_系统底上文字 这一档**不改**：它专门用于"仍由系统自画的浅色面"上的文字。
     本轮虽然重写了 ComboBox / DatePicker / ScrollBar 的模板（K-10 就此关闭），
     但日历里的部分子件与右键菜单仍是系统画的，留着这个键兜底。
     ═══════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 纯色：文字与语义状态 ── -->
    <SolidColorBrush x:Key="笔刷_文字">#ECECEF</SolidColorBrush>
    <SolidColorBrush x:Key="笔刷_次级文字">#BCC0C7</SolidColorBrush>
    <SolidColorBrush x:Key="笔刷_有票">#F0B267</SolidColorBrush>
    <SolidColorBrush x:Key="笔刷_成功">#7FD49A</SolidColorBrush>
    <SolidColorBrush x:Key="笔刷_错误">#FF8A80</SolidColorBrush>
    <SolidColorBrush x:Key="笔刷_底上文字">#FFF3F2</SolidColorBrush>

    <SolidColorBrush x:Key="笔刷_边框">#3A3B40</SolidColorBrush>
    <SolidColorBrush x:Key="笔刷_控件边界">#6E7480</SolidColorBrush>

    <SolidColorBrush x:Key="笔刷_系统底上文字">#1F1F1F</SolidColorBrush>

    <!-- 只剩这一个纯色底键：进度条轨道。与浅色档同一理由。 -->
    <SolidColorBrush x:Key="笔刷_徽标底">#2F3037</SolidColorBrush>

    <LinearGradientBrush x:Key="渐变_进度填充" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8FE0AA" Offset="0"/>
        <GradientStop Color="#4FA876" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="渐变_窗口底" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#242529" Offset="0"/>
        <GradientStop Color="#1D1E22" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="渐变_内容底" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B1B1E" Offset="0"/>
        <GradientStop Color="#22242A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="渐变_行底" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B1B1E" Offset="0"/>
        <GradientStop Color="#202226" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="渐变_徽标底" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2F3037" Offset="0"/>
        <GradientStop Color="#373941" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="渐变_输入底" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B1B1E" Offset="0"/>
        <GradientStop Color="#242730" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="渐变_弹层底" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26272C" Offset="0"/>
        <GradientStop Color="#2C2E35" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="渐变_页签底" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B1B1E" Offset="0"/>
        <GradientStop Color="#282A31" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="渐变_页签选中底" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#334053" Offset="0"/>
        <GradientStop Color="#2A3648" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="渐变_按钮底" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2C3B4F" Offset="0"/>
        <GradientStop Color="#334459" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="渐变_按钮按下底" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A5373" Offset="0"/>
        <GradientStop Color="#2F4560" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="渐变_提醒底" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3A2E1B" Offset="0"/>
        <GradientStop Color="#453721" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="渐变_错误底" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8C2F22" Offset="0"/>
        <GradientStop Color="#A33828" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
