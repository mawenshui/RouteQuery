<!-- ═══════════════════════════════════════════════════════════════
     深色色板（FR-35）。与浅色**键名必须完全一致**——切换主题是整本换掉，
     缺一个键不会报错，只会让那段文字落回默认颜色：深色底上一段黑字，正是验收①要拦的残留。
     深色下颜色一律提亮而不是照搬浅色值：#B3261E 在 #1B1B1E 上只有约 2.6:1，
     错误态必须醒目（FR-35 约束），所以换成 #FF8A80。
     ═══════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="笔刷_窗口底">#232428</SolidColorBrush>
    <SolidColorBrush x:Key="笔刷_内容底">#1B1B1E</SolidColorBrush>
    <SolidColorBrush x:Key="笔刷_徽标底">#2F3037</SolidColorBrush>
    <SolidColorBrush x:Key="笔刷_边框">#3A3B40</SolidColorBrush>
    <SolidColorBrush x:Key="笔刷_提醒底">#3A2E1B</SolidColorBrush>

    <SolidColorBrush x:Key="笔刷_文字">#ECECEF</SolidColorBrush>
    <SolidColorBrush x:Key="笔刷_次级文字">#B4B6BC</SolidColorBrush>

    <SolidColorBrush x:Key="笔刷_有票">#F0B267</SolidColorBrush>
    <SolidColorBrush x:Key="笔刷_成功">#7FD49A</SolidColorBrush>
    <SolidColorBrush x:Key="笔刷_错误">#FF8A80</SolidColorBrush>
    <SolidColorBrush x:Key="笔刷_错误底">#8C2F22</SolidColorBrush>
    <SolidColorBrush x:Key="笔刷_底上文字">#FFF3F2</SolidColorBrush>

    <SolidColorBrush x:Key="笔刷_系统底上文字">#1F1F1F</SolidColorBrush>

</ResourceDictionary>
