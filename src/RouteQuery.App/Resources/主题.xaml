<!-- ═══════════════════════════════════════════════════════════════
     主题骨架（FR-35 / 设计 v1.4"颜色一律走主题资源字典，禁止控件硬编码色值"）。

     这本字典**一个色值都不写**，只放引用色板键的样式；色值只在 浅色.xaml / 深色.xaml 里。
     切换主题 = 换掉 MergedDictionaries 里那一份色板，样式与界面文件都不动。

     样式里的颜色一律用 DynamicResource：用 StaticResource 的话切换后界面不会重新解析，
     "即时生效"就变成了"重启才生效"，而 FR-35 要求前者。
     ═══════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 文字 ── -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 余票高亮。原先走 IValueConverter 造 SolidColorBrush：那种颜色是编译期固定的，
         换主题不会跟着变，深色档位下会出现"深底配暗橙"或"浅字在浅底上"。
         改成样式触发器之后，主题切换时 setter 会被重新求值。三态另有文字（NFR-06）。 -->
    <Style x:Key="席别文字" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasTicket}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource 笔刷_有票}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── 控件：只改底色与字色，模板仍用系统的 ── -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_徽标底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource 笔刷_文字}"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
    </Style>

    <!-- ComboBox 的下拉弹层由系统模板画（浅色），所以把项的底色一起给成主题色，
         否则深色档位是"浅字落在浅弹层上"。弹层外框仍为系统浅色 → 记为 K-10 待界面走查 -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_成功}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_徽标底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <!-- DatePicker 的日历面板是系统画的浅色浮层，这里只保证输入框本体在两种主题下都能读 -->
    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

</ResourceDictionary>
