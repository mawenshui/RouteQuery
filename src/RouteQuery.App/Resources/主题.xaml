<!-- ═══════════════════════════════════════════════════════════════
     主题骨架（FR-35）+ 渐变皮肤（FR-38 / 设计 UI-001 v1.2 §六·五）。

     这本字典**一个色值都不写**，只放引用色板键的样式与模板；色值只在 浅色.xaml / 深色.xaml。
     切换主题 = 换掉 MergedDictionaries 里那一份色板，样式与界面文件都不动。

     v1.2 起重写 ComboBox / DatePicker / ScrollBar / TabItem 的 ControlTemplate。
     以前"只改 Background 不换模板"的结果就是 K-10：这几类控件的底色画在系统模板内部，
     外部设了不生效，深色档下是一片系统浅底。要渐变就必须重写模板——两件事是同一件活。

     颜色一律 DynamicResource：StaticResource 在换字典后不会重新求值，"即时生效"会变成"重启才生效"。
     ═══════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 文字 ──
         这里<b>没有</b> TargetType="TextBlock" 的隐式样式，是实测决定的：隐式样式会连系统模板里
         ContentPresenter 自造的 TextBlock 一起命中，深色档下下拉框因此"整排看不见字"。
         文字色一律靠窗口根元素 TextBlock.Foreground 往下继承。 -->

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 余票三态。**三态与"缺数"仍由文字区分**（NFR-06、FR-38），底色渐变不得把它们拉成同一视觉重量。 -->
    <Style x:Key="席别文字" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasTicket}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource 笔刷_有票}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="下拉箭头" TargetType="Path">
        <Setter Property="Data" Value="M 0 0 L 8 0 L 4 5 Z"/>
        <Setter Property="Fill" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ── 按钮：常态 / 悬停 / 按下 / 禁用 四态都要可辨 ── -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 渐变_按钮底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_控件边界}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="外框" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="外框" Property="BorderBrush" Value="{DynamicResource 笔刷_文字}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="外框" Property="Background" Value="{DynamicResource 渐变_按钮按下底}"/>
                        </Trigger>
                        <!-- 禁用态**不用透明度**：那会把文字一起糊掉，用户读不出"这里本来该有什么" -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="外框" Property="Background" Value="{DynamicResource 渐变_徽标底}"/>
                            <Setter TargetName="外框" Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
                            <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 输入框 ── -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 渐变_输入底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_控件边界}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="外框" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="2,0" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="外框" Property="BorderBrush" Value="{DynamicResource 笔刷_文字}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="外框" Property="Background" Value="{DynamicResource 渐变_徽标底}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 列表与行 ──
         行的底色只设 Background + 触发器，**不重写 ListViewItem 的模板**：
         结果列表用的是 GridView，自己重写模板就得正确绑 GridView 的列集合，
         绑错的表现是"整列空白而运行时不报错"——那正是本项目反复犯的形态。
         系统模板本来就会把 TemplatedParent.Background 画进行底，所以渐变照样吃得进去。 -->
    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 渐变_内容底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_控件边界}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 渐变_行底}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource 渐变_徽标底}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource 渐变_页签选中底}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 渐变_内容底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_控件边界}"/>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 渐变_行底}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource 渐变_徽标底}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource 渐变_页签选中底}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 渐变_徽标底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_控件边界}"/>
        <Setter Property="Padding" Value="6,3"/>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 渐变_行底}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource 渐变_徽标底}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource 渐变_页签选中底}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── 下拉框：整支模板重写（K-10 第一项）── -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="6,3"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource 渐变_徽标底}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource 渐变_页签选中底}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 渐变_输入底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_控件边界}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="外框" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"/>
                        <Grid Margin="6,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="选中项" Grid.Column="0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False"/>
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Margin="0,0,22,0"
                                     VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource 笔刷_文字}" CaretBrush="{DynamicResource 笔刷_文字}"
                                     Visibility="Hidden"/>
                            <ToggleButton x:Name="开关" Grid.Column="0" Grid.ColumnSpan="2"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <!-- 热区横跨整个控件（FR-39）：只让 22 像素的箭头可点，
                                             用户每次都要瞄准它，而"这一整块都是下拉框"才是他们的直觉。
                                             可编辑模式由触发器收回箭头那一格，否则打字点不进去。 -->
                                        <Border x:Name="底" Background="Transparent" CornerRadius="3">
                                            <Path Style="{StaticResource 下拉箭头}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="底" Property="Background" Value="{DynamicResource 渐变_页签底}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Border Background="{DynamicResource 渐变_弹层底}" BorderBrush="{DynamicResource 笔刷_控件边界}"
                                    BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="280">
                                <ScrollViewer Margin="2">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="选中项" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <!-- 可编辑时热区退回箭头那一格：盖住文字区就等于不能打字了 -->
                            <Setter TargetName="开关" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="开关" Property="Grid.ColumnSpan" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="外框" Property="BorderBrush" Value="{DynamicResource 笔刷_文字}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="外框" Property="Background" Value="{DynamicResource 渐变_徽标底}"/>
                            <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 日历里的两处底色：必须**先定义**再被 DatePicker 模板引用（StaticResource 不能前向引用）── -->
    <Style x:Key="日历格" TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinWidth" Value="22"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="底" Background="{TemplateBinding Background}" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="底" Property="Background" Value="{DynamicResource 渐变_提醒底}"/>
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="底" Property="Background" Value="{DynamicResource 渐变_页签选中底}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="底" Property="Background" Value="{DynamicResource 渐变_徽标底}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="日历按钮" TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="底" Background="Transparent" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="底" Property="Background" Value="{DynamicResource 渐变_徽标底}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 日期框（K-10 第二项）：四个 PART 名字一个都不能少，否则日历弹不出来 ── -->
    <Style TargetType="DatePicker">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 渐变_输入底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_控件边界}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="外框" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" BorderThickness="0"
                                               Background="Transparent" Foreground="{DynamicResource 笔刷_文字}"
                                               CaretBrush="{DynamicResource 笔刷_文字}" Padding="5,0,0,0"
                                               VerticalContentAlignment="Center"/>
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="按钮底" Background="Transparent" CornerRadius="0,3,3,0">
                                            <Path Style="{StaticResource 下拉箭头}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="按钮底" Property="Background" Value="{DynamicResource 渐变_徽标底}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="None">
                                <Border Background="{DynamicResource 渐变_弹层底}" BorderBrush="{DynamicResource 笔刷_控件边界}"
                                        BorderThickness="1">
                                    <Calendar x:Name="PART_Calendar" BorderThickness="0"
                                              Foreground="{DynamicResource 笔刷_文字}"
                                              Background="{DynamicResource 渐变_弹层底}"
                                              TextBlock.Foreground="{DynamicResource 笔刷_文字}"
                                              CalendarDayButtonStyle="{StaticResource 日历格}"
                                              CalendarButtonStyle="{StaticResource 日历按钮}"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="外框" Property="Background" Value="{DynamicResource 渐变_徽标底}"/>
                            <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 页签：两态都跟主题。v1.0 那处"页签条整条留给系统浅色"的妥协到此为止 ── -->
    <Style TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 渐变_内容底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_控件边界}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="3">
                        <DockPanel>
                            <TabPanel IsItemsHost="True" Background="Transparent" DockPanel.Dock="Top" Margin="6,6,6,0"/>
                            <Border BorderBrush="{DynamicResource 笔刷_边框}" BorderThickness="0,1,0,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                                  Margin="6"/>
                            </Border>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="底" Background="{DynamicResource 渐变_页签底}"
                            BorderBrush="{DynamicResource 笔刷_控件边界}" BorderThickness="1,1,1,0"
                            CornerRadius="3,3,0,0" Margin="0,0,-1,0" Padding="12,5">
                        <ContentPresenter x:Name="标题" ContentSource="Header" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="底" Property="Background" Value="{DynamicResource 渐变_页签选中底}"/>
                            <Setter TargetName="标题" Property="TextBlock.FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="底" Property="Background" Value="{DynamicResource 渐变_徽标底}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 滚动条（K-10 第三项）：横竖各一支模板。
         合成一支的做法会让横向的翻页命令仍是 PageUp/PageDown，点轨道会往反方向走。 ── -->
    <Style x:Key="滚动条滑块" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="底" Background="{DynamicResource 渐变_徽标底}" CornerRadius="3"
                            BorderBrush="{DynamicResource 笔刷_控件边界}" BorderThickness="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="底" Property="Background" Value="{DynamicResource 渐变_页签选中底}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="滚动条轨道键" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="滚动条纵向模板" TargetType="ScrollBar">
        <Border Background="{DynamicResource 渐变_内容底}">
            <Track IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource 滚动条轨道键}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource 滚动条滑块}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource 滚动条轨道键}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="滚动条横向模板" TargetType="ScrollBar">
        <Border Background="{DynamicResource 渐变_内容底}">
            <Track IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource 滚动条轨道键}" Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource 滚动条滑块}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource 滚动条轨道键}" Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <!-- 一支样式两个模板：横向的翻页命令与纵向不同，合成一支会让点轨道往反方向滚 -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Template" Value="{StaticResource 滚动条纵向模板}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="Template" Value="{StaticResource 滚动条横向模板}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── 容器与其余 ── -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="底" Background="{DynamicResource 渐变_页签底}" CornerRadius="3"
                            BorderBrush="{DynamicResource 笔刷_控件边界}" BorderThickness="1" Padding="8,3">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="底" Property="Background" Value="{DynamicResource 渐变_页签选中底}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="底" Property="BorderBrush" Value="{DynamicResource 笔刷_文字}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_控件边界}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource 渐变_徽标底}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0">
                            <ContentPresenter ContentSource="Header" Margin="8,4" TextBlock.FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="{DynamicResource 渐变_内容底}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="0,0,3,3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource 渐变_进度填充}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_徽标底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_控件边界}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 渐变_弹层底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_控件边界}"/>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource 渐变_徽标底}"/>
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <!-- ══ 菜单项（FR-41 / FR-44）══
         必须自带模板：系统那份的弹层底色走 SystemColors，深色档下会变成"深字落白底"的白块，
         正是 K-10 那一类问题。这里一个模板吃四种角色（顶栏项、顶栏带子菜单、子菜单项、子菜单带下一级），
         用 Role 触发器切换，因为本应用的菜单只有两层，写四份模板不值得。 -->
    <!-- 菜单里的分隔线：系统默认那条是浅灰白，落在深色弹层上就是一道亮线。 -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource 笔刷_边框}"/>
        <Setter Property="Margin" Value="4,3"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="底" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                            </Grid.ColumnDefinitions>
                            <!-- 勾选式菜单项（视图菜单）：勾在文字左边，不靠颜色单独表达状态 -->
                            <TextBlock x:Name="勾" Grid.Column="0" Text="✓" MinWidth="14"
                                       Visibility="Collapsed" FontWeight="Bold"
                                       Foreground="{DynamicResource 笔刷_成功}"
                                       VerticalAlignment="Center" Margin="2,0,2,0"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource HintText}"/>
                            <Path x:Name="箭头" Grid.Column="3" Style="{StaticResource 下拉箭头}"
                                  Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="None"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource 渐变_弹层底}"
                                        BorderBrush="{DynamicResource 笔刷_控件边界}" BorderThickness="1"
                                        Padding="2" MinWidth="180">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="箭头" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="勾" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuItem">
                            <Setter Property="MinHeight" Value="26"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="箭头" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Role" Value="SubmenuItem"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="勾" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="底" Property="Background" Value="{DynamicResource 渐变_页签选中底}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="底" Property="Background" Value="{DynamicResource 渐变_页签选中底}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ 分隔器（FR-40）══
         六像素的透明热区 + 一条分隔线，悬停时才浮出三个小点。
         一根永远看得见的小把手会把"可拖"变成视觉噪音，而看不见把手又等于不能拖——
         所以常态只留线（它本来也是两块区域的分界），悬停再给把手。 -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ShowsPreview" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="竖线" Width="1" HorizontalAlignment="Center"
                                Background="{DynamicResource 笔刷_边框}"/>
                        <Border x:Name="横线" Height="1" VerticalAlignment="Center"
                                Background="{DynamicResource 笔刷_边框}" Visibility="Collapsed"/>
                        <StackPanel x:Name="柄" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Width="3" Height="3" CornerRadius="2" Background="{DynamicResource 笔刷_控件边界}" Margin="0,1"/>
                            <Border Width="3" Height="3" CornerRadius="2" Background="{DynamicResource 笔刷_控件边界}" Margin="0,1"/>
                            <Border Width="3" Height="3" CornerRadius="2" Background="{DynamicResource 笔刷_控件边界}" Margin="0,1"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ResizeDirection" Value="Rows">
                            <Setter TargetName="竖线" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="横线" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="柄" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="竖线" Property="Background" Value="{DynamicResource 笔刷_控件边界}"/>
                            <Setter TargetName="横线" Property="Background" Value="{DynamicResource 笔刷_控件边界}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ 列表表头（FR-42）══
         表头那一行画在 ScrollViewer 外面（见主窗口的列表模板），所以这里的单元格是普通控件：
         不可排序的列用 表头文字，可排序的列用 表头按钮——两者字号字重一致，
         否则用户会以为能点的那几列是另一种东西。 -->
    <!-- ══ 反馈条（FR-46）══
         四级共用这一个形态：同样的边框、内边距、圆角与字号，级别只换底色与文字色。
         级别由 Tag 带进来（warn / error，其余按提示处理），而 Tag 的值来自视图模型对文案键的判断——
         样式不猜句子，视图模型不画颜色。 -->
    <Style x:Key="反馈条" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource 渐变_徽标底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="warn">
                <Setter Property="Background" Value="{DynamicResource 渐变_提醒底}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_控件边界}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="error">
                <Setter Property="Background" Value="{DynamicResource 渐变_错误底}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_控件边界}"/>
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource 笔刷_底上文字}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="表头文字" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="9,6"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="表头按钮" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ToolTip" Value="{DynamicResource 表头_可排序提示}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="底" Background="Transparent" CornerRadius="2" Padding="9,6">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="底" Property="Background" Value="{DynamicResource 渐变_页签底}"/>
                            <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="底" Property="Background" Value="{DynamicResource 渐变_页签选中底}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
