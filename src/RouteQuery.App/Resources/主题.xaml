<!-- ═══════════════════════════════════════════════════════════════
     主题骨架（FR-35 / 设计 v1.4"颜色一律走主题资源字典，禁止控件硬编码色值"）。

     这本字典**一个色值都不写**，只放引用色板键的样式；色值只在 浅色.xaml / 深色.xaml 里。
     切换主题 = 换掉 MergedDictionaries 里那一份色板，样式与界面文件都不动。

     样式里的颜色一律用 DynamicResource：用 StaticResource 的话切换后界面不会重新解析，
     "即时生效"就变成了"重启才生效"，而 FR-35 要求前者。
     ═══════════════════════════════════════════════════════════════ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 文字 ──
         这里<b>没有</b> <c>TargetType="TextBlock"</c> 的隐式样式，是实测决定的：
         隐式样式会连系统控件模板里生成的 TextBlock 一起命中（ContentPresenter 显示字符串时就是这么造的），
         于是深色档下 ComboBox 的"全部车型"变成"浅字落在浅底上"——整排下拉框看着是空的。
         改成在每个窗口根元素上写 TextBlock.Foreground 让它<b>往下继承</b>：
         继承的优先级低于控件默认样式自己的 Setter，所以我的文字跟着主题走，
         而 ComboBox / DatePicker 仍然用系统那套深字浅底，读得清。 -->

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 余票高亮。原先走 IValueConverter 造 SolidColorBrush：那种颜色是编译期固定的，
         换主题不会跟着变，深色档位下会出现"深底配暗橙"或"浅字在浅底上"。
         改成样式触发器之后，主题切换时 setter 会被重新求值。三态另有文字（NFR-06）。 -->
    <Style x:Key="席别文字" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_次级文字}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasTicket}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource 笔刷_有票}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── 控件：只改底色与字色，模板仍用系统的 ── -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_徽标底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource 笔刷_文字}"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
    </Style>

    <!-- ComboBox 与 DatePicker **刻意不给底色**。
         2026-10-12 深色档实测：底色一换成深色，系统模板里那两处选中文字不跟着 Foreground 走，
         结果是"深底配深字"——车型下拉框和日期框几乎看不见。看不见就是不合格（FR-35 验收①）。
         要让深色真正贯通得重写这两个控件的 ControlTemplate，那是另一件事、要另一次走查。
         现在这样是"浅色控件落在深色窗口上"，丑，但读得清。 -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <!-- TabControl 必须显式给 Foreground：系统默认样式在这里设的是 SystemColors.ControlTextBrush，
         它会盖掉从窗口继承下来的主题文字色——实测深色档下页签内容区那句提示变成"深字配深底"，整块看不见。
         页签标题不受影响（由上面的 TabItem 样式单独管）。 -->
    <Style TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_文字}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_内容底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <!-- 页签两个状态都由系统画成浅底（2026-10-12 深色实测：未选中的那一页也是浅底，
         先按状态分两种文字色，结果未选中的"中转换乘"整块变成空白）。
         所以两档主题下页签文字都用"落在系统浅底上的那个深色"——页签条本身不跟随主题，
         这是不重写 ControlTemplate 的前提下唯一两种状态都能读的做法。 -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_系统底上文字}"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource 笔刷_成功}"/>
        <Setter Property="Background" Value="{DynamicResource 笔刷_徽标底}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_边框}"/>
    </Style>

    <!-- DatePicker 与 ListBox 的滚动条同属"要重写模板才能深色"的一类，见上面那条注释，这里不再单独给色 -->

</ResourceDictionary>
