<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RouteQuery.Core\RouteQuery.Core.csproj" />
    <ProjectReference Include="..\RouteQuery.Data\RouteQuery.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <!-- 视图模型的异步动作（查询、经停、扩展、中转、码表更新）是 internal 的：
         命令本身是 async void，测试要 await 才能断言"跑完之后状态是什么"。
         只对测试程序集开这一个口子，与数据层对会话读取的处理方式一致。 -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>RouteQuery.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 分发件叫 RouteQuery.exe：工程名带 .App 后缀是给开发者看的，不该出现在亲友的桌面上（SPEC-006 发布物清单） -->
    <AssemblyName>RouteQuery</AssemblyName>
    <!-- 版本号的唯一来源（SPEC-006 一）。界面"关于"页与发布说明都读这里，禁止在文案里手写版本串 -->
    <Version>0.4.0-rc3</Version>
  </PropertyGroup>

</Project>
