<Window x:Class="RouteQuery.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RouteQuery.App.Converters"
        xmlns:vm="clr-namespace:RouteQuery.App.ViewModels"
        Title="{DynamicResource 应用名}"
        Width="1280" Height="800" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, PingFang SC, Segoe UI" FontSize="13"
        Background="{DynamicResource 渐变_窗口底}" TextBlock.Foreground="{DynamicResource 笔刷_文字}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Window.Resources>
        <conv:ViewStateToVisibilityConverter x:Key="StateVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:CountToBoolConverter x:Key="CountBool"/>
        
            </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource 渐变_徽标底}"
                BorderBrush="{DynamicResource 笔刷_控件边界}" BorderThickness="1" CornerRadius="4"
                Padding="4,2" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="0" Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="{DynamicResource 菜单_文件}">
                        <MenuItem Header="{DynamicResource 菜单_更新码表}" Click="UpdateStations_Click"/>
                        <MenuItem Header="{DynamicResource 菜单_清空数据}" Click="Settings_Click"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource 菜单_退出}" Click="Exit_Click"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource 菜单_视图}">
                        <MenuItem Header="{DynamicResource 视图_侧栏}" IsCheckable="True"
                                  IsChecked="{Binding ShowSidebar}"/>
                        <MenuItem Header="{DynamicResource 视图_筛选栏}" IsCheckable="True"
                                  IsChecked="{Binding ShowFilters}"/>
                        <MenuItem Header="{DynamicResource 视图_详情区}" IsCheckable="True"
                                  IsChecked="{Binding ShowDetail}"/>
                        <MenuItem Header="{DynamicResource 视图_信息条}" IsCheckable="True"
                                  IsChecked="{Binding ShowInfoBar}"/>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource 菜单_主题}">
                        <MenuItem Header="{DynamicResource 主题_跟随系统}" IsCheckable="True"
                                  IsChecked="{Binding ThemeFollows, Mode=OneWay}" Click="Theme_Click" Tag="跟随系统"/>
                        <MenuItem Header="{DynamicResource 主题_浅色}" IsCheckable="True"
                                  IsChecked="{Binding ThemeLight, Mode=OneWay}" Click="Theme_Click" Tag="浅色"/>
                        <MenuItem Header="{DynamicResource 主题_深色}" IsCheckable="True"
                                  IsChecked="{Binding ThemeDark, Mode=OneWay}" Click="Theme_Click" Tag="深色"/>
                    </MenuItem>
                    <!-- 设置是一级项，不藏在"帮助"里：它是日常要动的地方，不是求助入口（FR-48）。 -->
                    <MenuItem Header="{DynamicResource 菜单_设置}" Click="Settings_Click"/>
                    <MenuItem Header="{DynamicResource 菜单_帮助}">
                        <MenuItem Header="{DynamicResource 菜单_发布页}" Click="OpenRelease_Click"/>
                        <MenuItem Header="{DynamicResource 菜单_再看声明}" Click="ShowStatement_Click"/>
                    </MenuItem>
                </Menu>

                <!-- 信息条：站点日期 + 更新入口 + 状态 + 额度 + 弱提示 + 声明 + 设置。
                     额度必须常驻（FR-43 把消耗从"点按钮"挪到了"点行"，用户要看得见自己在花什么）。 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                            Visibility="{Binding ShowInfoBar, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource 提示_站点数据}" Style="{StaticResource HintText}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StationDataDate, Mode=OneWay}" VerticalAlignment="Center"
                               FontWeight="SemiBold" Margin="5,0,0,0"/>
                    <Button Content="{DynamicResource 菜单_更新码表}" FontSize="11" Padding="8,1" Margin="8,0,0,0"
                            VerticalAlignment="Center" Click="UpdateStations_Click"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource HintText}"
                           VerticalAlignment="Center" Margin="16,0,8,0" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding ShowInfoBar, Converter={StaticResource BoolVis}}"/>

                <Button Grid.Column="3" Content="{Binding UpdateNote}" Padding="10,2" Margin="8,0,0,0"
                        FontSize="11" Foreground="{DynamicResource 笔刷_成功}" Background="Transparent" BorderThickness="0"
                        Click="OpenRelease_Click" VerticalAlignment="Center"
                        Visibility="{Binding HasUpdateNote, Converter={StaticResource BoolVis}}"/>

                <TextBlock Grid.Column="4" Text="{DynamicResource 声明_非官方}" Style="{StaticResource HintText}"
                           VerticalAlignment="Center" Margin="12,0,2,0"
                           Visibility="{Binding ShowInfoBar, Converter={StaticResource BoolVis}}"/>


            </Grid>
        </Border>

        <Grid x:Name="BodyGrid" Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" MinWidth="160"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Margin="0,0,0,0" Visibility="{Binding ShowSidebar, Converter={StaticResource BoolVis}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource 侧栏_收藏}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource 按钮_收藏本次}" Padding="8,2"
                    Click="SaveRoute_Click"/>
        </DockPanel>
        <ListBox Grid.Row="1" x:Name="SavedList" Margin="0,6,0,0"
                 ItemsSource="{Binding SavedRoutes}" MouseDoubleClick="Saved_DoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- 删除必须就在这一行上：收藏满 20 条时的提示让用户"先删一条"，
                         没有入口的话那句话就是一句做不到的指示。 -->
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource 按钮_删除收藏}"
                                FontSize="11" Padding="6,0" Click="RemoveSaved_Click"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource 侧栏_历史}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="{DynamicResource 按钮_清空历史}" Padding="8,2"
                    Click="ClearHistory_Click"/>
        </DockPanel>
        <ListBox Grid.Row="3" x:Name="HistoryList" Margin="0,6,0,0"
                 ItemsSource="{Binding History}" MouseDoubleClick="History_DoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding RouteText}"/>
                        <TextBlock Text="{Binding WhenText}" FontSize="11" Style="{StaticResource HintText}"/>
                        <TextBlock Text="{Binding CountText}" FontSize="11" Style="{StaticResource HintText}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 收藏与回填的反馈就在这一区里（FR-47）：点"收藏这一程"之后眼睛就在这块，
             不在窗口左下角的一行小灰字上。收藏已满这类是警示级，会换成提醒底。 -->
        <Border Grid.Row="4" Style="{StaticResource 反馈条}" Tag="{Binding BookLevel}"
                Visibility="{Binding BookHasNotice, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding BookStatus}" TextWrapping="Wrap" FontSize="12"/>
        </Border>
    </Grid>

    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"
                          Visibility="{Binding ShowSidebar, Converter={StaticResource BoolVis}}"/>
    <Grid x:Name="MainGrid" Grid.Column="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="280" MinHeight="120"/>
        </Grid.RowDefinitions>

        <!-- ══ 查询栏 ══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="FromBox" Padding="8,6" VerticalContentAlignment="Center"
                         Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{DynamicResource 标签_出发站}"
                         PreviewKeyDown="FromBox_PreviewKeyDown" LostFocus="Box_LostFocus"
                                 MouseLeftButtonUp="PickerBox_Click">
                    <!-- FR-04 要求"输入框标红"：光说"哪个框不对"不够，眼睛要能直接落到框上 -->
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FromInvalid}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_错误}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Popup PlacementTarget="{Binding ElementName=FromBox}" Placement="Bottom" StaysOpen="False"
                       IsOpen="{Binding FromCandidates.Count, Mode=OneWay, Converter={StaticResource CountBool}}">
                    <ListBox x:Name="FromList" Width="230" MaxHeight="280" DisplayMemberPath="Name"
                             ItemsSource="{Binding FromCandidates}"
                             SelectedItem="{Binding FromPick, Mode=TwoWay}"/>
                </Popup>
            </Grid>

            <Button Grid.Column="1" Content="{DynamicResource 按钮_互换}" Margin="6,0"
                    Click="Swap_Click" ToolTip="交换出发站与到达站"/>

            <Grid Grid.Column="2">
                <TextBox x:Name="ToBox" Padding="8,6" VerticalContentAlignment="Center"
                         Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{DynamicResource 标签_到达站}"
                         PreviewKeyDown="ToBox_PreviewKeyDown" LostFocus="Box_LostFocus" MouseLeftButtonUp="PickerBox_Click">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToInvalid}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource 笔刷_错误}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Popup PlacementTarget="{Binding ElementName=ToBox}" Placement="Bottom" StaysOpen="False"
                       IsOpen="{Binding ToCandidates.Count, Mode=OneWay, Converter={StaticResource CountBool}}">
                    <ListBox x:Name="ToList" Width="230" MaxHeight="280" DisplayMemberPath="Name"
                             ItemsSource="{Binding ToCandidates}"
                             SelectedItem="{Binding ToPick, Mode=TwoWay}"/>
                </Popup>
            </Grid>

            <DatePicker x:Name="DateBox" Grid.Column="3" Margin="6,0" VerticalContentAlignment="Center"
                        SelectedDate="{Binding TravelDateValue, Mode=TwoWay}"
                        DisplayDateStart="{Binding DateMin, Mode=OneWay}" DisplayDateEnd="{Binding DateMax, Mode=OneWay}"
                                PreviewMouseLeftButtonUp="DateBox_Click"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0">
                <Button Content="{DynamicResource 快捷_今天}" Margin="3,0" Click="QuickDate_Click" Tag="0"/>
                <Button Content="{DynamicResource 快捷_明天}" Margin="3,0" Click="QuickDate_Click" Tag="1"/>
                <Button Content="{DynamicResource 快捷_后天}" Margin="3,0" Click="QuickDate_Click" Tag="2"/>
            </StackPanel>

            <TextBlock Grid.Column="5" Text="{DynamicResource 提示_可查范围}"
                       Style="{StaticResource HintText}" Margin="10,0" VerticalAlignment="Center"/>

            <!-- 额度紧贴查询按钮：它约束的就是"点查询"和"点行取经停"这两个动作，
                 放在窗口另一头等于离动作最远的地方（FR-48）。 -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DailyRemainingText}" Style="{StaticResource HintText}"
                           VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="{Binding QueryButtonText}" MinWidth="96" Padding="12,6"
                        Command="{Binding QueryCommand}"/>
            </StackPanel>

            <Button Grid.Column="7" Content="{DynamicResource 按钮_取消}" MinWidth="72" Padding="12,6"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"
                    Click="Cancel_Click" Margin="6,0,0,0"/>
        </Grid>

        <!-- ══ 筛选与排序 ══ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8" Visibility="{Binding ShowFilters, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{DynamicResource 筛选_车型}" Style="{StaticResource HintText}" Margin="0,0,6,0"/>
            <ComboBox Width="120" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}"/>
            <TextBlock Text="{DynamicResource 筛选_时段}" Style="{StaticResource HintText}" Margin="16,0,6,0"/>
            <ComboBox Width="120" ItemsSource="{Binding BandOptions}" SelectedItem="{Binding SelectedBand}"/>
            <CheckBox Content="{DynamicResource 筛选_只看有票}" Margin="16,0,0,0" VerticalAlignment="Center"
                      IsChecked="{Binding OnlyAvailable}"/>
            <CheckBox Content="{DynamicResource 筛选_当天到达}" Margin="12,0,0,0" VerticalAlignment="Center"
                      IsChecked="{Binding SameDayArrival}"/>
            <Button Content="{DynamicResource 筛选_清除}" Margin="12,0,0,0" Padding="10,2"
                    Command="{Binding ClearFiltersCommand}"/>
            <TextBlock Text="{DynamicResource 排序_标题}" Style="{StaticResource HintText}" Margin="24,0,6,0"/>
            <ComboBox Width="110" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"/>
        </StackPanel>

        <!-- ══ 结果区 ══ -->
        <TabControl Grid.Row="2" Background="Transparent" BorderBrush="{DynamicResource 笔刷_边框}">
            <TabItem Header="{DynamicResource 页签_直达}">
                <!-- 页签标题由主题样式定成"落在系统浅页签上的深色"，那份颜色会顺着内容继承下来，
                     所以内容区必须在这里把文字色重新定回主题色，否则深色档下整页内容是深字配深底。 -->
                <Grid TextBlock.Foreground="{DynamicResource 笔刷_文字}">
                    <TextBlock Text="{DynamicResource 状态_空}" TextWrapping="Wrap" Margin="24"
                               VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620"
                               TextAlignment="Center" FontSize="14"
                               Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Empty}"/>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Loading}">
                        <TextBlock Text="{DynamicResource 状态_加载}" FontSize="14"/>
                        <ProgressBar IsIndeterminate="True" Width="220" Height="4" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- 出错：文案本身已含"下一步做什么"，重试按钮只在可重试类错误出现（SPEC-007 三.7） -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620"
                                Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Error}">
                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource 笔刷_错误}"
                                   FontSize="14" TextAlignment="Center"/>
                        <Button Content="{DynamicResource 按钮_重试}" Margin="0,12,0,0" Padding="14,5"
                                HorizontalAlignment="Center"
                                Visibility="{Binding CanRetry, Converter={StaticResource BoolVis}}"
                                Command="{Binding QueryCommand}"/>
                    </StackPanel>

                    <!-- 车次列表 -->
                    <ListView x:Name="ResultList" Margin="0,20,0,40" ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}"
                              BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Results}">
                                <ListView.Template>
                                    <ControlTemplate TargetType="ListView">
                                        <Border Background="{DynamicResource 渐变_内容底}"
                                                BorderBrush="{DynamicResource 笔刷_边框}" BorderThickness="1" CornerRadius="3">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Top"
                                                        Background="{DynamicResource 渐变_徽标底}"
                                                        BorderBrush="{DynamicResource 笔刷_边框}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{DynamicResource 表头_车次}"
                                                                   Style="{StaticResource 表头文字}"/>
                                                        <Button Grid.Column="1" Style="{StaticResource 表头按钮}"
                                                                Command="{Binding DataContext.SortByDepartureCommand, RelativeSource={RelativeSource AncestorType=ListView}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{DynamicResource 表头_出发}"/>
                                                                <TextBlock Text="{Binding DataContext.FromSortMarker, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                           Margin="5,0,0,0" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="2" Style="{StaticResource 表头按钮}"
                                                                Command="{Binding DataContext.SortByArrivalCommand, RelativeSource={RelativeSource AncestorType=ListView}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{DynamicResource 表头_到达}"/>
                                                                <TextBlock Text="{Binding DataContext.ToSortMarker, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                           Margin="5,0,0,0" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="3" Style="{StaticResource 表头按钮}"
                                                                Command="{Binding DataContext.SortByDurationCommand, RelativeSource={RelativeSource AncestorType=ListView}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{DynamicResource 表头_历时}"/>
                                                                <TextBlock Text="{Binding DataContext.DurationSortMarker, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                           Margin="5,0,0,0" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <TextBlock Grid.Column="4" Text="{DynamicResource 表头_席别}"
                                                                   Style="{StaticResource 表头文字}"/>
                                                        <Button Grid.Column="5" Style="{StaticResource 表头按钮}"
                                                                Command="{Binding DataContext.SortByPriceCommand, RelativeSource={RelativeSource AncestorType=ListView}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{DynamicResource 表头_最低价}"/>
                                                                <TextBlock Text="{Binding DataContext.PriceSortMarker, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                           Margin="5,0,0,0" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <TextBlock Grid.Column="6" Text="{DynamicResource 表头_操作}"
                                                                   Style="{StaticResource 表头文字}"/>
                                                    </Grid>
                                                </Border>
                                                <ScrollViewer Focusable="False" Padding="1"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <ItemsPresenter/>
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>
                                    </ControlTemplate>
                                </ListView.Template>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="8,7"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding TrainCode}" FontWeight="Bold" FontSize="14"/>
                                        <Border Background="{DynamicResource 渐变_徽标底}" CornerRadius="3" Padding="4,0" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding KindLabel}" FontSize="11"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                        <Run Text="{Binding DepartureText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding FromName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center">
                                        <Run Text="{Binding ArrivalText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding ToName, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding ArrivalDayNote, Mode=OneWay}" Foreground="{DynamicResource 笔刷_错误}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" VerticalAlignment="Center"/>
                                    <!-- 官方给的每个席别都摆出来，各带自己的余票与票价（FR-49）。
                                         一行一条而不是挤成一句：挤成一句就得"摘选"，
                                         而摘选掉的正是用户抱怨"不齐全"的那些。 -->
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding SeatLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource 席别文字}"
                                                               TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding OnSaleText}" FontSize="11"
                                                   Style="{StaticResource HintText}"
                                                   Visibility="{Binding IsNotYetOnSale, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="5" Text="{Binding LowestPriceText}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                                        <Button Content="{DynamicResource 按钮_看经停}" Padding="8,2" Margin="4,0,0,0"
                                                Command="{Binding LoadStopsCommand}"/>
                                        <Button Content="{DynamicResource 按钮_多买几站}" Padding="8,2" Margin="4,0,0,0"
                                                Visibility="{Binding CanBuyOnline, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                                Command="{Binding DataContext.RunExtensionCommand, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 票价口径（FR-34）：常驻、不折叠、不放进"?"。价格就在上方几列里，说明必须贴着价格放，
                         否则用户读到的是"官方票价"而不是"成人票面价"。 -->
                    <TextBlock Text="{DynamicResource 票价_口径}" TextWrapping="Wrap" FontSize="11"
                               Style="{StaticResource HintText}" Margin="8,0,8,10" VerticalAlignment="Bottom"
                               Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=Results}"/>

                    <TextBlock Text="{DynamicResource 状态_筛选后空}" TextWrapping="Wrap" Margin="24"
                               VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620"
                               TextAlignment="Center" FontSize="14"
                               Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter=FilteredEmpty}"/>

                    <!-- 官方给了零趟：这句话属于结果区，不属于窗口顶部（FR-47）。
                         字号与"还没有查询"同一档——同一类"这里没有东西"就该长一个样。 -->
                    <TextBlock Text="{Binding EmptyResultText}" TextWrapping="Wrap" Margin="24"
                               VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620"
                               TextAlignment="Center" FontSize="14"
                               Visibility="{Binding IsEmptyResult, Converter={StaticResource BoolVis}}"/>

                    <!-- "共 x 趟车"贴在表上方（FR-48）：它说的是这张表有几行。 -->
                    <!-- 列表让出 20 像素顶边，这句就落在表上方而不是压在"操作"两个字上。 -->
                    <TextBlock Text="{Binding ResultCountText}" Style="{StaticResource HintText}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,6,0"
                               Visibility="{Binding HasResults, Converter={StaticResource BoolVis}}"/>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource 页签_中转}">
                <Grid TextBlock.Foreground="{DynamicResource 笔刷_文字}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600"
                                Visibility="{Binding HasLoginSession, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <TextBlock Text="{Binding SessionSummary}" TextWrapping="Wrap" TextAlignment="Center" FontSize="14"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button Content="{DynamicResource 登录_按钮}" Padding="14,5" Click="Login_Click"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource 中转_需登录}" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,14,0,0" Style="{StaticResource HintText}"/>
                    </StackPanel>

                    <DockPanel Margin="8" Visibility="{Binding HasLoginSession, Converter={StaticResource BoolVis}}">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="{DynamicResource 中转_查询}" Padding="14,5"
                                    Command="{Binding TransferQueryCommand}"/>
                            <Border Style="{StaticResource 反馈条}" Tag="{Binding TransferLevel}" Margin="14,0,0,0"
                                    VerticalAlignment="Center" MaxWidth="620"
                                    Visibility="{Binding TransferHasNotice, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding TransferStatus}" TextWrapping="Wrap" FontSize="12"/>
                            </Border>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource 中转_说明}" TextWrapping="Wrap"
                                   Margin="0,8,0,0" FontSize="11" Style="{StaticResource HintText}"/>

                        <ListView ItemsSource="{Binding Transfers}" BorderThickness="0"
                                  Visibility="{Binding HasTransfers, Converter={StaticResource BoolVis}}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding TrainsText}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock FontSize="11" Style="{StaticResource HintText}">
                                                <Run Text="{Binding TimesText, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding ArrivalDayNote, Mode=OneWay}" Foreground="{DynamicResource 笔刷_错误}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding RouteText}"/>
                                            <TextBlock Text="{Binding TransferText}" FontSize="11" Style="{StaticResource HintText}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TotalText}" VerticalAlignment="Center"/>
                                        <!-- FR-15：两段各自展开、各自收起，互不干扰。所以每段自己带一份经停列表，
                                             不共用下面那块详情面板——共用就只能同时看一段，而比方案要两段对着读。 -->
                                        <ItemsControl Grid.Column="3" ItemsSource="{Binding Legs}" VerticalAlignment="Center">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource HintText}"
                                                                       Margin="0,0,6,0" MinWidth="34"/>
                                                            <TextBlock Text="{Binding SeatsText}"/>
                                                            <Button Content="{Binding ToggleLabel}" Padding="7,0" Margin="10,0,0,0"
                                                                    Command="{Binding ToggleCommand}" FontSize="11"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding HeadText}" FontSize="11"
                                                                   Style="{StaticResource HintText}" Margin="0,1,0,0"/>
                                                        <TextBlock Text="{Binding ErrorText}" FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource 笔刷_错误}"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"/>
                                                        <ItemsControl ItemsSource="{Binding Stops}" Margin="0,3,0,0"
                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="34"/>
                                                                            <ColumnDefinition Width="104"/>
                                                                            <ColumnDefinition Width="52"/>
                                                                            <ColumnDefinition Width="52"/>
                                                                            <ColumnDefinition Width="52"/>
                                                                            <ColumnDefinition Width="20"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding StationNo}" FontSize="11"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding StationName}" FontSize="11"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding ArriveText}" FontSize="11"/>
                                                                        <TextBlock Grid.Column="3" Text="{Binding DepartText}" FontSize="11"/>
                                                                        <TextBlock Grid.Column="4" Text="{Binding StopoverText}" FontSize="11"/>
                                                                        <TextBlock Grid.Column="5" Text="{Binding Marker}" FontSize="11"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Column="4" Text="{Binding PriceText}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource 笔刷_有票}" FontSize="11" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ══ 详情：经停站 + 多买几站 ══ -->
                <!-- 结果区 ⇕ 详情区。详情区被隐藏时这条也随之消失（FR-40）。 -->
                <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"
                              Margin="0,2" Visibility="{Binding ShowDetail, Converter={StaticResource BoolVis}}"/>

                <!-- ══ 详情：经停站 + 多买几站（FR-43 起：选中即出数，不再必须点按钮）══
                     折叠按钮与"视图"菜单改的是同一个布尔值；隐藏后想再出来，勾菜单或直接点某行的"经停站"。 -->
                <Border Grid.Row="4" Margin="0,10,0,0" CornerRadius="4"
                        Background="{DynamicResource 渐变_内容底}"
                        BorderBrush="{DynamicResource 笔刷_控件边界}" BorderThickness="1"
                        Visibility="{Binding ShowDetail, Converter={StaticResource BoolVis}}">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource 渐变_徽标底}"
                                BorderBrush="{DynamicResource 笔刷_边框}" BorderThickness="0,0,0,1"
                                CornerRadius="4,4,0,0" Padding="10,6">
                            <DockPanel LastChildFill="False">
                                <Button DockPanel.Dock="Left" Content="{Binding DetailToggleGlyph}"
                                        Width="22" Padding="0" Margin="0,0,6,0" Click="ToggleDetail_Click"
                                        ToolTip="{DynamicResource 视图_详情区}"/>
                                <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <Run Text="{Binding Selected.TrainCode, Mode=OneWay}"/><Run Text="  "/><Run Text="{DynamicResource 详情_标题}"/><Run Text="  "/>
                                </TextBlock>
                                <!-- 起售时间（FR-33）：官方列 55 没给就整块不出现；未到与已过是两句话 -->
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Selected.OnSaleNote}" Margin="12,0,0,0"
                                           Style="{StaticResource HintText}" VerticalAlignment="Center"
                                           Visibility="{Binding Selected.HasOnSale, Converter={StaticResource BoolVis}}"/>
                                <Button DockPanel.Dock="Right" Content="{DynamicResource 按钮_跳官方}" Padding="10,2"
                                        Margin="12,0,0,0" Command="{Binding OpenOfficialCommand}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding OfficialReminder}" MaxWidth="480"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                            </DockPanel>
                        </Border>

                        <Grid Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0" Header="{DynamicResource 详情_经停标题}">
                                <Grid>
                                    <ListView ItemsSource="{Binding Stops}" BorderThickness="0"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="{DynamicResource 详情_站序}" Width="46" DisplayMemberBinding="{Binding StationNo}"/>
                                                <GridViewColumn Header="{DynamicResource 详情_站名}" Width="150" DisplayMemberBinding="{Binding StationName}"/>
                                                <GridViewColumn Header="{DynamicResource 详情_到时}" Width="76" DisplayMemberBinding="{Binding ArriveText}"/>
                                                <GridViewColumn Header="{DynamicResource 详情_发时}" Width="76" DisplayMemberBinding="{Binding DepartText}"/>
                                                <GridViewColumn Header="{DynamicResource 详情_停留}" Width="80" DisplayMemberBinding="{Binding StopoverText}"/>
                                                <GridViewColumn Header="" Width="30" DisplayMemberBinding="{Binding Marker}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <!-- 取不到经停是错误，不是"这里刚好没字"：错误级样式，写在这块区域里（FR-46/47）。 -->
                                    <Border Style="{StaticResource 反馈条}" Tag="{Binding DetailLevel}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400"
                                            Visibility="{Binding HasDetailNotice, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding DetailHint}" TextWrapping="Wrap"
                                                   TextAlignment="Center" FontSize="12"/>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <GroupBox Grid.Column="2" Header="{DynamicResource 扩展_标题}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource 扩展_上限}" Style="{StaticResource HintText}"/>
                                        <ComboBox Width="56" Margin="8,0" SelectedItem="{Binding MaxExtensionStations}"
                                                  ItemsSource="{Binding StationChoices}"/>
                                        <Button Content="{DynamicResource 按钮_开始扩展}" Padding="10,2"
                                                Command="{Binding RunExtensionCommand}"/>
                                        <TextBlock Text="{Binding ExtensionSummary}" Margin="12,0,0,0" Style="{StaticResource HintText}"/>
                                    </StackPanel>

                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <Border Style="{StaticResource 反馈条}" Tag="{Binding ExtensionLevel}"
                                                Visibility="{Binding ExtensionHasNotice, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding ExtensionStatus}" TextWrapping="Wrap" FontSize="12"/>
                                        </Border>
                                        <TextBlock Text="{Binding ExtensionDisclaimer}" Margin="0,4,0,0" FontSize="11" Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <ListView ItemsSource="{Binding Extensions}" BorderThickness="0">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding ExtraText}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding RouteText}" FontSize="11" Style="{StaticResource HintText}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding SeatSummary}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PriceText}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding DeltaText}" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAnomalous}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource 笔刷_错误}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsBuyable}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource 笔刷_成功}"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </DockPanel>
                            </GroupBox>
                        </Grid>
                    </DockPanel>
                </Border>
    </Grid>
        </Grid>
    </Grid>
</Window>
