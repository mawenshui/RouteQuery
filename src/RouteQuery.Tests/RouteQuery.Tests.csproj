<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>   <!-- 跟随数据层：被测代码含 Windows 专用 API -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RouteQuery.Core\RouteQuery.Core.csproj" />
    <ProjectReference Include="..\RouteQuery.Data\RouteQuery.Data.csproj" />
    <!-- 引用 App 工程只为了测 DomainGuard 这类纯函数。它住在界面层，但一行 WPF 都不碰——
         "白名单判定不依赖 UI"这件事本身就是被这条引用证明的。 -->
    <ProjectReference Include="..\RouteQuery.App\RouteQuery.App.csproj" />
  </ItemGroup>

</Project>
