<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RouteQuery.Core\RouteQuery.Core.csproj" />
  </ItemGroup>

  <!-- 内置站点码表：**嵌进程序集**而不是随 exe 放一个文件。
       断网也能完成一次查询（FR-18 / NFR-11），而"只拷了 exe 就报读不出站点数据"这个坑随之消失。
       手动更新的新码表仍然写成本地文件并优先于内置副本（见 StationTableLoader.LoadUpdated）。 -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\stations.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 登录态的读取路径刻意是 internal（见 ProtectedSessionStore 注释）。测试要断言
         "磁盘上没有明文、内存里能取回原值"，只能对这个可见性开一个口子，且只对测试程序集。 -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>RouteQuery.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <!-- 数据层用 DPAPI（仅 Windows）加密登录态，因此本程序集如实声明只在 Windows 上跑：
         比在代码里逐处压 CA1416 警告诚实，也比"假装跨平台"少一层误导。整个应用本就是 Windows 桌面件。 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
